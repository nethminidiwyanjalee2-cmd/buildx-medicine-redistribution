# MediStock — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or serviceAccount.json to the repository.

# ── Firebase ──────────────────────────────────────────────────────────────────
# Local emulator project ID (keep as demo-medistock for the emulator)
FIRESTORE_PROJECT_ID=demo-medistock

# Set this when running the Firebase emulator locally
FIRESTORE_EMULATOR_HOST=localhost:8080

# Path to service-account JSON for production Firestore (never commit this file)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# ── Database fallback ─────────────────────────────────────────────────────────
# Directory for JSON fallback store (auto-created if absent)
# JSON_DATA_DIR=backend/app/data/json_store

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ── Inventory thresholds (days of stock) ─────────────────────────────────────
# Override only if you have domain-specific justification
# CRITICAL_STOCK_DAYS=3
# WARNING_STOCK_DAYS=7
# EXCESS_STOCK_DAYS=30
